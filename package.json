{
  "name": "@bfun/cli",
  "version": "5.0.1",
  "description": "@bfun/cli",
  "keywords": [
    "@bfun/cli"
  ],
  "homepage": "https://github.com/bfunjs/cli#readme",
  "bugs": {
    "url": "https://github.com/bfunjs/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfunjs/cli.git"
  },
  "license": "MIT",
  "author": "suibinc@qq.com",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "ci": "npm run build && npm test",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "oclif readme && git add README.md"
  },
  "bin": {
    "bfun": "bin/run.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "oclif": {
    "bin": "bfun",
    "commands": "./dist/commands",
    "dirname": "bfun",
    "topicSeparator": " "
  },
  "dependencies": {
    "@bfun/utils": "^1.1.2",
    "@oclif/core": "^4.11.14",
    "axios": "^1.18.1",
    "compare-versions": "^6.1.1",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.1.1",
    "oclif": "^4.23.27",
    "prettier": "^3.9.5",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ]
}
